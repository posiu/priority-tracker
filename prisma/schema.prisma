generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String?  @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime @default(now())

  accounts      Account[]
  sessions      Session[]

  dailyPlans    DailyPlan[]
  workLogs      WorkLog[]
  ingests       Ingest[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model DailyPlan {
  id        String   @id @default(cuid())
  userId    String
  planDate  DateTime
  note      String?
  createdAt DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     PlanItem[]

  @@unique([userId, planDate])
}

model PlanItem {
  id          String   @id @default(cuid())
  planId      String
  rank        Int
  title       String
  description String?
  category    String?
  estMinutes  Int?
  status      String   @default("planned") // planned|done|moved|dropped

  plan        DailyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  workLogs    WorkLog[]
}

model WorkLog {
  id                   String   @id @default(cuid())
  userId               String
  logDate              DateTime
  source               String?  // manual|email|file|calendar
  title                String
  description          String?
  category             String?
  minutesSpent         Int      @default(0)
  relatedPlanItemId    String?
  isUnplanned          Boolean  @default(false)
  createdAt            DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planItem PlanItem? @relation(fields: [relatedPlanItemId], references: [id])
}

model Ingest {
  id           String   @id @default(cuid())
  userId       String
  source       String   // email|file|drive|slack|github
  externalId   String?
  filename     String?
  mime         String?
  storageUrl   String?
  extractedTxt String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  code  String @id
  label String
}
